# ============================================
# CONFIGURACIÓN LOCAL DE DESARROLLO
# Copiar este archivo como .env y ajustar
# ============================================

# ===== Base de datos =====
DB_HOST=jdbc:postgresql://host:5432/postgres
DB_USER=postgres.tu_usuario
DB_PASSWORD=tu_password_aca

# ===== pgAdmin =====
PGADMIN_EMAIL=admin@reservas.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# JWT (cambiar en producción por algo largo y aleatorio)
JWT_SECRET=cambiar-esto-en-produccion-debe-ser-largo-y-aleatorio-minimo-256-bits
JWT_EXPIRATION_MS=86400000

# ===== Mercado Pago (sandbox por ahora) =====
# Conseguir en: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=TEST-tu-access-token-aca
MP_PUBLIC_KEY=TEST-tu-public-key-aca
MP_WEBHOOK_SECRET=cambiar-por-secret-de-webhook

# ===== Email (a definir: SendGrid / Mailgun / SES) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@reservas.local


# ===== CORS (frontend en dev) =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
