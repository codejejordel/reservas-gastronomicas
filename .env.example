# ============================================
# CONFIGURACIÓN LOCAL DE DESARROLLO
# Copiar este archivo como .env y ajustar
# ============================================

# ===== Base de datos =====
DB_HOST=jdbc:postgresql://postgres:5432/reservas
DB_USER=reservas_user
DB_PASSWORD=reservas_pass_dev
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# ===== pgAdmin =====
PGADMIN_EMAIL=admin@reservas.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# JWT (cambiar en producción por algo largo y aleatorio)
JWT_SECRET=cambiar-esto-en-produccion-debe-ser-largo-y-aleatorio-minimo-256-bits
JWT_EXPIRATION_MS=86400000

# ===== Mercado Pago (sandbox por ahora) =====
# Conseguir en: https://www.mercadopago.com.ar/developers/panel/app
# Access token de prueba de la aplicación del vendedor
MP_ACCESS_TOKEN=APP_USR-4337417772410177-082410-bc72f309c876e05516df65302a589408-3324704135
MP_PUBLIC_KEY=APP_USR-05762f91-0531-43bb-8a05-d28d607ebe01
# ID numérico del vendedor global; requerido para verificar la propiedad del pago
MP_COLLECTOR_ID=3324704135
# Secret de Webhooks de la aplicación; requerido para autenticar notificaciones
MP_WEBHOOK_SECRET=57284b77dee4040fb444fa875204ca384ea2ed1e0097af5fdb0f25fffa6a5fce
# URL base pública HTTPS del backend; requerida para recibir webhooks
MP_WEBHOOK_BASE_URL=https://pale-papua-travelers-nebraska.trycloudflare.com/api
# URL del frontend usada por Mercado Pago para los retornos del checkout
FRONTEND_URL=https://kay-abs-demand-forty.trycloudflare.com

# ===== Email (a definir: SendGrid / Mailgun / SES) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@reservas.local


# ===== CORS (frontend en dev) =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
